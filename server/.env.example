HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=10
# Reverse proxies (IP or CIDR, JSON list) trusted to set X-Forwarded-For /
# X-Real-IP. Empty = ignore those headers and rate-limit by the real TCP peer.
# Set this ONLY when behind a known proxy, e.g. TRUSTED_PROXIES=["127.0.0.1"].
TRUSTED_PROXIES=[]
# Required for auth on /extract and /ws/extract. Leave empty to disable auth
# (NOT recommended for a public deployment).
EXTRACT_API_KEY=
# Required to enable POST /update-ytdlp. Empty = endpoint disabled.
UPDATE_API_KEY=
# Hard ceiling on a single extraction (seconds).
EXTRACT_TIMEOUT_SECONDS=120
# Max concurrent WS proxy extraction sessions.
WS_MAX_CONCURRENT_SESSIONS=8
